# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (email autorisé pour les APIs admin)
ADMIN_EMAIL=yakoumobi@gmail.com

# Emails de notification (Resend) — optionnel
RESEND_API_KEY=

# Rate limiting login (Upstash) — optionnel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paiement page /suivi — optionnel (affiché uniquement si renseigné)
NEXT_PUBLIC_RIB=
NEXT_PUBLIC_CHARGILY_URL=

# SMS marketing (Twilio) — optionnel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# JARVIS — assistant personnel connecté à Claude (Anthropic)
# Clé API depuis https://console.anthropic.com/settings/keys — sans elle, /jarvis/chat reste
# désactivé mais le reste de JARVIS (tâches, agenda, finances, objectifs) fonctionne normalement.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
