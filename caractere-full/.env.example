# ============================================================================
# Supabase Configuration
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Yalidine Configuration — Plateforme de livraison Algérienne
# ============================================================================

# API Key Yalidine (obtenu sur dashboard.yalidine.app)
YALIDINE_API_KEY=your-api-key-here

# Secret API Yalidine
YALIDINE_API_SECRET=your-api-secret-here

# Mode sandbox (true pour développement, false pour production)
YALIDINE_SANDBOX=true

# ============================================================================
# Application Configuration
# ============================================================================

# Mode d'environnement
NODE_ENV=development

# URL de l'app (pour webhooks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Webhooks & Intégrations
# ============================================================================

# Webhook secret pour Yalidine (à générer)
YALIDINE_WEBHOOK_SECRET=your-webhook-secret-here
